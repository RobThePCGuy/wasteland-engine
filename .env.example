# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: REQUIRED. Secret used to sign/verify session tokens (HS256).
# The server refuses to start in production (NODE_ENV=production) if this is unset.
# Use a long random value, e.g. `openssl rand -base64 48`. Never commit the real value.
JWT_SECRET="CHANGE-ME-to-a-long-random-string"

# STRUCTURED_GENERATION: optional. Set to "true" to enable the AI structured world-generation
# pipeline (server/generation/*). Default off — the deterministic legacy travel path is used.
# Before enabling in production, run a live integration smoke test of travel -> generate ->
# admit -> realize -> persist with a real GEMINI_API_KEY (the generateLocationSpec step calls Gemini).
# STRUCTURED_GENERATION="false"
